(fireaway_prod) {
    encode zstd gzip

    handle /health {
        reverse_proxy backend-prod:8000
    }

    handle /api/* {
        reverse_proxy backend-prod:8000
    }

    handle {
        reverse_proxy frontend-prod:3000
    }
}

fireaway.site, www.fireaway.site {
    import fireaway_prod
}

fireaway.csml.co.za {
    tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key
    import fireaway_prod
}