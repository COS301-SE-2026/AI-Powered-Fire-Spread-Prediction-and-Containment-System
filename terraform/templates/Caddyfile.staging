(fireaway_staging) {
    encode zstd gzip

    handle /health {
        reverse_proxy backend-staging:8000
    }

    handle /api/* {
        reverse_proxy backend-staging:8000
    }

    handle {
        reverse_proxy frontend-staging:3000
    }
}

staging.fireaway.site, demo.fireaway.site {
    import fireaway_prod
}

fireaway.csml.co.za {
    tls /etc/caddy/cloudflare-origin.pem /etc/caddy/cloudflare-origin.key
    import fireaway_prod
}