{
  "name": "fire-spread-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "app/backend/src",
    "app/frontend/src"
  ],
  "scripts": {
    "dev": "yarn --cwd app/frontend/src dev",
    "build": "yarn --cwd app/frontend/src build",
    "lint": "yarn --cwd app/frontend/src lint",
    "test:e2e": "yarn --cwd app/frontend/src test:e2e",
    "test:backend": "yarn --cwd app/backend test:backend",
    "test:unit": "yarn --cwd app/backend test:unit",
    "test:integration": "yarn --cwd app/backend test:integration",
    "test:unit:cov": "yarn --cwd app/backend test:unit:cov",
    "test:integration:cov": "yarn --cwd app/backend test:integration:cov"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "postcss": "^8.5.14"
  },
  "dependencies": {
    "lucide-react": "^0.577.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
