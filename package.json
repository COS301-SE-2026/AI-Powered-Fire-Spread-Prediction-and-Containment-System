{
  "name": "fire-spread-monorepo",
  "private": true,
  "workspaces": [
    "app/backend",
    "app/frontend",
    "app/pwa"
  ],
  "scripts": {
    "dev": "yarn --cwd app/frontend dev",
    "build": "yarn --cwd app/frontend build",
    "lint": "yarn --cwd app/frontend lint",
    "test:e2e": "yarn --cwd app/frontend test:e2e",
    "test:e2e:backend": "pytest -q app/backend/testing_config/e2e",
    "pwa:start": "yarn --cwd app/pwa start",
    "test:xgboost:unit": "pytest app/backend/tests/ai/test_xgboost_model_unit.py -v",
    "test:xgboost:integration": "pytest app/backend/tests/ai/test_xgboost_model_integration.py -v"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "postcss": "^8.5.14"
  },
  "dependencies": {
    "lucide-react": "^0.577.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
