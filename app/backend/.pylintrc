[MASTER]
ignore=testing_config
ignore-paths=
    .*/\venv/.*,
    .*/__pycache__/.*,
    .*/\pytest_cache/.*,
    ^app/artifact_store/.*$,

[MESSAGES CONTROL]
disable=
    C0114,
    C0115,
    C0116,
    W0511,
    C0305,
    C0415,
    R0903,
    C0303,
    R0914,
    R0915,
    E0401,

[FORMAT]
max-line-length=120

[DESIGN]
max-args=20

[REPORTS]
fail-under=8.0