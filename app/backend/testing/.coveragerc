[run]
data_file = .coverage
branch= true
relative_files = true
source = app/backend

[paths]
source =
    app/backend
    /github/workspace/app/backend

[report]
show_missing = true
omit = 
    app/backend/testing/*
    app/backend/seed.py
    app/backend/test_api.py
    app/backend/ml/training/build_*.py
    app/backend/ml/training/load_real_dataset.py
    app/backend/ml/training/synthetic_data.py
    app/backend/ml/training/train_ignition.py
    app/backend/src/ai/build_*.py
    app/backend/src/ai/inspect_fire.py